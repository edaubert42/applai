<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ name }}</title>
<style>
  @page { size: A4; margin: {{ margins }}; }
  :root { --accent: #035DAB; --ink: #161616; --mute: #555; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: "Inter", "Aptos", "Helvetica Neue", Arial, sans-serif; font-size: 10.5pt; line-height: 1.4; color: var(--ink); -webkit-print-color-adjust: exact; }
  header { padding-bottom: 3mm; border-bottom: 0.75pt solid var(--accent); }
  header h1 { margin: 0 0 1mm; font-size: 20pt; line-height: 1.1; font-weight: 600; letter-spacing: -0.01em; color: var(--accent); }
  header p { margin: 0; color: var(--mute); }
  .place-date { margin: 10mm 0 0; text-align: right; }
  .recipient { margin: 8mm 0 0; font-weight: 600; }
  .subject { margin: 8mm 0 6mm; font-weight: 600; }
  .body p { margin: 0 0 4mm; white-space: pre-line; }
</style>
</head>
<body>
<header>
  <h1>{{ name }}</h1>
  <p>{{ email }} | {{ phone }}</p>
  <p>{{ city }}</p>
</header>
<p class="place-date">{{ place_date }}</p>
<p class="recipient">{{ company }}</p>
<p class="subject">{{ subject }}</p>
<div class="body">
{% for paragraph in paragraphs %}<p>{{ paragraph }}</p>
{% endfor %}</div>
</body>
</html>
