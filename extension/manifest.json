{
  "manifest_version": 3,
  "name": "ApplAI",
  "version": "0.3.0",
  "description": "Reads offer pages and forms, and fills waiting forms with this Chrome's session. Never sends.",
  "permissions": ["alarms", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "https://*.jobteaser.com/*",
    "https://*.google.com/*",
    "https://*.google.fr/*",
    "https://*.ashbyhq.com/*",
    "https://*.lever.co/*",
    "https://*.greenhouse.io/*",
    "https://*.workable.com/*",
    "https://*.teamtailor.com/*",
    "https://*.welcometothejungle.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.recruitee.com/*",
    "https://*.hellowork.com/*",
    "https://*.lesjeudis.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" }
}
