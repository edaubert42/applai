{
  "manifest_version": 3,
  "name": "ApplAI",
  "version": "0.1.0",
  "description": "Reads the JobTeaser and Google offer pages ApplAI asks for, with this Chrome's session.",
  "permissions": ["alarms"],
  "host_permissions": [
    "https://*.jobteaser.com/*", "https://*.google.com/*", "https://*.google.fr/*", "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" }
}
